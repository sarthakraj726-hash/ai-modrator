# ==============================================================================
# GODDESS AI / AI-MODRATOR - ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================

# Application Environment (development, production, testing)
APP_ENV=development
APP_NAME=goddess-ai-modrator
LOG_LEVEL=INFO
HOST=0.0.0.0
PORT=8000

# Security & Admin Access
ADMIN_SECRET=change-this-to-a-secure-random-secret-in-production

# PostgreSQL Database Connection
# Production: postgresql+asyncpg://user:password@host:port/database
# Local/Testing: sqlite+aiosqlite:///./ai_modrator.db
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/ai_modrator

# Redis Connection (Cache, Distributed Locks, Events)
REDIS_URL=redis://localhost:6379/0

# YouTube Data API v3 Key Pool
YOUTUBE_API_KEY_1=your_youtube_api_key_1_here
YOUTUBE_API_KEY_2=your_youtube_api_key_2_here
YOUTUBE_API_KEY_3=your_youtube_api_key_3_here

# YouTube Daily Quota Hard Budget (Units per Day)
YOUTUBE_QUOTA_DAILY_LIMIT=4000

# OpenRouter LLM Gateway (Future AI Provider)
OPENROUTER_API_KEY=your_openrouter_api_key_here
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_DEFAULT_MODEL=anthropic/claude-3.5-sonnet

# Discord Bot & Logging Integration (Future Observability)
DISCORD_BOT_TOKEN=your_discord_bot_token_here
DISCORD_DEV_CHANNEL_ID=your_discord_dev_channel_id_here
